{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "run_shell_command|write_file|edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/adapters/claude/post-tool-use.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/adapters/claude/stop.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
